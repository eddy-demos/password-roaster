{
  "name": "honest-password-meter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @hpm/server dev\" \"pnpm --filter @hpm/web dev\"",
    "build": "pnpm --filter @hpm/server build && pnpm --filter @hpm/web build",
    "start": "pnpm --filter @hpm/server start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @hpm/web test:e2e",
    "db:migrate": "pnpm --filter @hpm/server db:migrate",
    "db:seed": "pnpm --filter @hpm/server db:seed",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
